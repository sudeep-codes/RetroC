// Edits #1-#2 (Modify): reading 102 was faulty (-999.0, invalid); fix its temperature, then mark it valid
retro modify sensor_readings[1].temp_c = 22.0
retro modify sensor_readings[1].valid = true

// Edit #3 (Insert): add a sensor calibration stage (+0.5 C bias correction)
retro insert before temp_f as calibrated : map(_, r => { id: r.id, temp_c: r.temp_c + 0.5, valid: r.valid })

// Edit #4 (Delete): remove the temporary calibration stage again
retro delete calibrated
